// apps/api/prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  RESPONDER
}

enum IncidentStatus {
  DETECTED
  ACKNOWLEDGED
  INVESTIGATING
  IDENTIFIED
  MITIGATING
  RESOLVED
  CLOSED
}

enum Severity {
  SEV1
  SEV2
  SEV3
  SEV4
}

enum TaskStatus {
  UNCLAIMED
  CLAIMED
  COMPLETED
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  passwordHash       String
  name               String
  role               Role                @default(RESPONDER)
  tokenVersion       Int                 @default(0)
  createdAt          DateTime            @default(now())
  timelineEvents     TimelineEvent[]
  incidentResponders IncidentResponder[]
}

model Incident {
  id             String              @id @default(uuid())
  title          String
  description    String
  severity       Severity
  status         IncidentStatus      @default(DETECTED)
  commanderId    String?
  createdBy      String
  createdAt      DateTime            @default(now())
  resolvedAt     DateTime?
  resolutionNote String?
  tasks          Task[]
  responders     IncidentResponder[]
  comments       Comment[]
  decisions      Decision[]
  timelineEvents TimelineEvent[]
}

model Task {
  id          String     @id @default(uuid())
  incidentId  String
  incident    Incident   @relation(fields: [incidentId], references: [id])
  title       String
  status      TaskStatus @default(UNCLAIMED)
  claimedBy   String?
  claimedAt   DateTime?
  completedAt DateTime?
  version     Int        @default(0)
  createdAt   DateTime   @default(now())

  @@index([incidentId])
}

model IncidentResponder {
  incidentId String
  incident   Incident  @relation(fields: [incidentId], references: [id])
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  joinedAt   DateTime  @default(now())
  leftAt     DateTime?

  @@id([incidentId, userId])
  @@index([userId])
}

model Comment {
  id         String   @id @default(uuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id])
  userId     String
  body       String
  createdAt  DateTime @default(now())

  @@index([incidentId])
}

model Decision {
  id           String   @id @default(uuid())
  incidentId   String
  incident     Incident @relation(fields: [incidentId], references: [id])
  madeBy       String
  decisionText String
  reason       String
  status       String   @default("APPROVED")
  createdAt    DateTime @default(now())

  @@index([incidentId])
}

model TimelineEvent {
  id         String   @id @default(uuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id])
  type       String
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([incidentId, createdAt])
}